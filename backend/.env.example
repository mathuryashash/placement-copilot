# Backend environment variables — copy to .env and fill in values
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:18401/placement_copilot
GROQ_API_KEY=
GEMINI_API_KEY=
# CORS: set to your frontend origin in production
CORS_ORIGINS=http://localhost:18402,http://localhost:3000
# Fake LLM mode (no API key needed; returns deterministic stubs for tests)
FAKE_LLM=false
# Cache directory for LLM responses
LLM_CACHE_DIR=./llm_cache
HF_HOME=./hf_cache
